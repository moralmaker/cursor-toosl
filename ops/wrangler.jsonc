{
  "name": "cursor-tools-ops",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./admin-ui/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cursor-tools-ops",
      "database_id": "efd31268-46ca-49b6-af35-90ce40419743",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "cursor-tools-ops-images"
    },
    {
      "binding": "RELEASES",
      "bucket_name": "cursor-tools-ops-releases"
    }
  ],
  "vars": {
    "ADMIN_USERNAME": "admin",
    "PUBLIC_CACHE_TTL": "300"
  },
  "routes": [
    {
      "pattern": "ops.susuan.ai",
      "custom_domain": true
    }
  ]
}
